---
import Logo from "./Logo.astro";
import { path, t, type Lang } from "../i18n";
import { CATEGORIES, type Category } from "../lib/calculators";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const year = new Date().getFullYear();
const issueUrl =
  "https://github.com/numflo-hq/numflo-web/issues/new?labels=content,translation&title=" +
  encodeURIComponent({ en: "Translation issue", es: "Error de traducción", de: "Übersetzungsfehler" }[lang]);
---

<footer class="border-line mt-20 border-t">
  <div class="container-page flex flex-col gap-8 py-10 xl:flex-row xl:items-start xl:justify-between">
    <div class="max-w-sm">
      <div class="flex items-center gap-2 font-bold">
        <Logo class="size-6" /> numflo
      </div>
      <p class="text-muted mt-3 text-sm">{d.site.footerNote}</p>
    </div>
    <nav
      aria-label={d.site.footerNav}
      class="text-muted grid grid-cols-2 gap-x-6 gap-y-6 text-sm hyphens-auto [overflow-wrap:anywhere] sm:gap-x-10 lg:grid-cols-4"
    >
      {(Object.keys(CATEGORIES) as Category[]).map((cat) => (
        <div>
          <p class="text-ink mb-2 font-semibold" id={`footer-${cat}`}>
            {d.site.categories[cat]}
          </p>
          <ul class="flex flex-col gap-2" role="list" aria-labelledby={`footer-${cat}`}>
            {CATEGORIES[cat].map((c) => (
              <li>
                <a class="hover:text-ink underline-offset-4 hover:underline" href={path(c, lang)}>
                  {d.home.cards[c].title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <p class="text-ink mb-2 font-semibold" id="footer-info">
          {d.site.name}
        </p>
        <ul class="flex flex-col gap-2" role="list" aria-labelledby="footer-info">
          <li>
            <a class="hover:text-ink underline-offset-4 hover:underline" href={path("about", lang)}>
              {d.site.about}
            </a>
          </li>
          <li>
            <a class="hover:text-ink underline-offset-4 hover:underline" href={path("terms", lang)}>
              {d.site.terms}
            </a>
          </li>
          <li>
            <a class="hover:text-ink underline-offset-4 hover:underline" href={path("disclaimer", lang)}>
              {d.site.disclaimer}
            </a>
          </li>
          <li>
            <a class="hover:text-ink underline-offset-4 hover:underline" href={path("privacy", lang)}>
              {d.site.privacy}
            </a>
          </li>
          <li>
            <a
              class="hover:text-ink underline-offset-4 hover:underline"
              href={issueUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              {d.site.reportTranslation}
            </a>
          </li>
        </ul>
      </div>
    </nav>
  </div>
  <div class="container-page text-muted pb-8 text-xs">
    © {year} {d.site.rights}
  </div>
</footer>
