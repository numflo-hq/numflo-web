{
  "name": "numflo-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Numflo - free multilingual financial calculators (numflo.com)",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild-check.mjs",
    "preview": "astro preview --port 4321",
    "serve": "node scripts/serve.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:lighthouse": "npx --yes @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
