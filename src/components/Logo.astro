---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<svg class={className} viewBox="0 0 64 64" aria-hidden="true" focusable="false">
  <rect width="64" height="64" rx="16" fill="var(--c-accent)"></rect>
  <path
    d="M12 42c6 0 8-8 14-8s8 8 14 8 8-20 12-26"
    fill="none"
    stroke="var(--c-accent-ink)"
    stroke-width="6"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <circle cx="52" cy="16" r="4.5" fill="var(--c-interest)"></circle>
</svg>
