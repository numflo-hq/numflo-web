---
import Logo from "./Logo.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { path, t, type Lang, type RouteKey } from "../i18n";
import { CATEGORIES, type Category } from "../lib/calculators";

interface Props {
  lang: Lang;
  route: RouteKey | null;
}
const { lang, route } = Astro.props;
const d = t(lang);
---

<header class="bg-bg/85 border-line sticky top-0 z-40 border-b backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-3">
    <a
      href={path("home", lang)}
      class="flex items-center gap-2.5 rounded-lg font-bold"
      aria-label={`${d.site.name} – ${d.site.home}`}
    >
      <Logo class="size-8" />
      <span class="text-lg tracking-tight">numflo</span>
    </a>
    <nav aria-label={d.site.calculators} class="flex items-center gap-2">
      <details class="hidden sm:block" data-menu>
        <summary class="hover:bg-surface-2 inline-flex min-h-11 cursor-pointer list-none items-center gap-1.5 rounded-xl px-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
          {d.site.calculators}
          <svg viewBox="0 0 20 20" class="size-4 opacity-60" aria-hidden="true" fill="currentColor">
            <path d="M5.5 7.5 10 12l4.5-4.5"></path>
          </svg>
        </summary>
        <div class="card absolute end-4 top-full z-30 mt-1 grid max-h-[calc(100dvh-5rem)] w-[min(44rem,calc(100vw-2rem))] gap-1 overflow-y-auto p-2 sm:grid-cols-2 md:grid-cols-3">
          {(Object.keys(CATEGORIES) as Category[]).map((cat) => (
            <div>
              <p
                class="text-muted px-3 pt-2 pb-1 text-xs font-semibold tracking-wide uppercase"
                id={`menu-${cat}`}
              >
                {d.site.categories[cat]}
              </p>
              <ul role="list" aria-labelledby={`menu-${cat}`}>
                {CATEGORIES[cat].map((c) => (
                  <li>
                    <a
                      href={path(c, lang)}
                      aria-current={route === c ? "page" : undefined}
                      class:list={[
                        "hover:bg-surface-2 flex min-h-11 items-center rounded-lg px-3 text-sm font-medium",
                        route === c && "text-accent",
                      ]}
                    >
                      {d.home.cards[c].title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </details>
      <LanguageSwitcher lang={lang} route={route} />
      <button
        type="button"
        class="btn-ghost px-3"
        data-theme-toggle
        aria-label={d.site.theme}
        aria-pressed="false"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5 dark:hidden"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path>
        </svg>
        <svg
          viewBox="0 0 24 24"
          class="hidden size-5 dark:block"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
