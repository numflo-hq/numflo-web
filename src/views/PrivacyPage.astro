---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { LAST_REVIEWED, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const updated = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" }).format(
  new Date(LAST_REVIEWED.privacy),
);
---

<BaseLayout lang={lang} route="privacy" title={d.meta.privacy.title} description={d.meta.privacy.description}>
  <div class="container-page max-w-3xl pt-8">
    <Breadcrumbs lang={lang} current={d.privacy.heading} />
    <h1 class="mt-4 text-3xl font-bold sm:text-4xl">{d.privacy.heading}</h1>
    <p class="text-muted mt-2 text-sm">
      {d.privacy.updated}: <time datetime={LAST_REVIEWED.privacy}>{updated}</time>
    </p>
    <div class="prose-body mt-6">
      {d.privacy.paragraphs.map((p) => (
        <p>{p}</p>
      ))}
      <p>{d.privacy.contact}</p>
    </div>
  </div>
</BaseLayout>
