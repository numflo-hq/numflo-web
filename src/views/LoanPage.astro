---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import LoanCalculator from "../components/LoanCalculator.astro";
import { HREFLANG, LAST_REVIEWED, path, t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.loan.content;
const url = new URL(path("loan", lang), Astro.site).href;
const reviewed = new Intl.DateTimeFormat(lang, { dateStyle: "long", timeZone: "UTC" }).format(
  new Date(LAST_REVIEWED.loan),
);

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: d.loan.heading,
    url,
    description: d.meta.loan.description,
    applicationCategory: "FinanceApplication",
    operatingSystem: "Any",
    browserRequirements: "Requires JavaScript for live updates",
    inLanguage: HREFLANG[lang],
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    dateModified: LAST_REVIEWED.loan,
    publisher: { "@id": `${Astro.site!.href}#organization` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: d.site.home,
        item: new URL(path("home", lang), Astro.site).href,
      },
      { "@type": "ListItem", position: 2, name: d.loan.heading, item: url },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    inLanguage: HREFLANG[lang],
    mainEntity: c.faqs.map((f) => ({
      "@type": "Question",
      name: f.q,
      acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
  },
];
---

<BaseLayout
  lang={lang}
  route="loan"
  title={d.meta.loan.title}
  description={d.meta.loan.description}
  schema={schema}
>
  <div class="container-page pt-6 sm:pt-8">
    <Breadcrumbs lang={lang} current={d.loan.heading} />
    <div class="mt-4 mb-6 max-w-2xl">
      <h1 class="text-3xl font-bold sm:text-4xl">{d.loan.heading}</h1>
      <p class="text-muted mt-2 text-lg">{d.loan.lead}</p>
    </div>

    <LoanCalculator lang={lang} />

    <article class="mx-auto mt-14 max-w-3xl">
      <section class="border-accent bg-accent-soft rounded-2xl border-s-4 p-5" aria-labelledby="summary">
        <h2 id="summary" class="text-lg font-semibold">
          {c.summaryTitle}
        </h2>
        <p class="mt-2">{c.summary}</p>
      </section>

      {c.sections.map((s, i) => (
        <section class="mt-10" aria-labelledby={`s-${i}`}>
          <h2 id={`s-${i}`} class="text-2xl font-bold">
            {s.title}
          </h2>
          <div class="prose-body text-ink/90 mt-3">
            {s.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        </section>
      ))}

      <section class="mt-12" aria-labelledby="faq">
        <h2 id="faq" class="text-2xl font-bold">
          {c.faqTitle}
        </h2>
        <div class="mt-4 flex flex-col gap-3">
          {c.faqs.map((f) => (
            <details class="card group p-5">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">
                <h3 class="text-base">{f.q}</h3>
                <svg
                  viewBox="0 0 20 20"
                  class="size-5 shrink-0 transition-transform group-open:rotate-180"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m5 7.5 5 5 5-5" />
                </svg>
              </summary>
              <p class="text-muted mt-3">{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="border-line mt-12 border-t pt-6 text-sm" aria-labelledby="method">
        <h2 id="method" class="font-semibold">
          {c.methodologyTitle}
        </h2>
        <p class="text-muted mt-1">{c.methodology}</p>
        <p class="text-muted mt-3">{c.disclaimer}</p>
        <p class="text-muted mt-3">
          {c.lastReviewed}: <time datetime={LAST_REVIEWED.loan}>{reviewed}</time>
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
